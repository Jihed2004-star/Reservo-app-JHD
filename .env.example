# Copy to `.env` (same folder as docker-compose.yaml) to override the defaults.
# Every entry is optional — `docker compose up --build` works without this file.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=myapp_user
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=myapp

# --- API --------------------------------------------------------------------
# Development = Swagger + detailed errors. Production disables both.
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=U856JZ1QSrql0bH7H6WfkTGj+zez4gePlspoPQH0KxM=
JWT_ISSUER=MyApp
JWT_EXPIRY_MINUTES=1440

# --- First administrator (created on startup by AdminSeeder) ----------------
# Change the password before exposing this stack anywhere.
ADMIN_EMAIL=admin@reservo.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Reservo Administrator

# --- Frontend ---------------------------------------------------------------
# Must be the API URL as seen from the browser (the host), not `api:8080`.
VITE_API_URL=http://localhost:8000/api
